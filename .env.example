# ==============================================================================
# Builder — Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to git.
# Run `pnpm gen:secrets` to generate random AUTH_SECRET and ENCRYPTION_KEY values.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
# During local testing with Cloudflare Tunnel, set API_PUBLIC_URL to the tunnel URL
# (e.g. https://builder-api.trycloudflare.com). Defaults to APP_URL if local.
API_PUBLIC_URL="http://localhost:3000"

# Optional client-side public URLs (if different from APP_URL / API_PUBLIC_URL)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_API_PUBLIC_URL="http://localhost:3000"

# Optional Desktop shell app URL override
# BUILDER_APP_URL="http://localhost:3000"

# Set "true" to allow URL cloning from localhost / private IP ranges in development
ALLOW_LOCAL_IMPORTS="false"

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# Works with any standard PostgreSQL: local install, Supabase, Railway, VPS.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"
# Direct database connection URL (bypasses Supabase connection pooler for migrations/worker)
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"
# Isolated test database URL used only during automated test runs
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"
# Set to 'false' if using Supabase connection pooler (Transaction mode) which disables prepared statements
DATABASE_PREPARE="true"

# ------------------------------------------------------------------------------
# Redis (TCP connection)
# Works with any Redis-compatible TCP server (Upstash, Memurai, local Redis, Railway, VPS).
# Must start with redis:// or rediss://.
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# Optional BullMQ queue isolation prefix (e.g. "dev" or "test")
QUEUE_PREFIX=""

# ------------------------------------------------------------------------------
# File Storage (S3 API compatible or Cloudinary)
# Browsers upload directly to storage with presigned PUT or signed POST; files never pass through server.
# Optional: leave STORAGE_PROVIDER blank to disable file storage (feature will be cleanly OFF).
# Supported values: "s3" or "cloudinary".
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=""

# If STORAGE_PROVIDER="s3":
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""
# Set to 'true' if using MinIO or local S3 instances without subdomain virtual hosts
S3_FORCE_PATH_STYLE="false"

# If STORAGE_PROVIDER="cloudinary":
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# ------------------------------------------------------------------------------
# 32-byte secret generated via `pnpm gen:secrets`
AUTH_SECRET="your-32-byte-base64-secret-here"

# Google OAuth (Optional — the Google login button appears only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Universal AI Models & Provider Fallback Chains (Vercel AI SDK)
# No model names in code. Any model or provider works by editing .env with zero code changes.
# Comma-separated list of <provider>:<model-id> in fallback order.
# Optional: leave AI_MODEL_CHAIN empty to run with AI features cleanly OFF.
# ------------------------------------------------------------------------------
AI_MODEL_CHAIN=""
# Optional per-task overrides (defaults to AI_MODEL_CHAIN if unset):
AI_MODEL_CHAIN_PLAN=""
AI_MODEL_CHAIN_SECTIONS=""
AI_MODEL_CHAIN_TEXT=""
# Note: Providers listed in AI_MODEL_CHAIN_VISION MUST have VISION="true"
AI_MODEL_CHAIN_VISION=""

# AI Generation pipeline mode: "page" (full page generation) or "section" (modular sections)
AI_GENERATION_MODE="page"

# AI request timeout in milliseconds before failing over to the next model in chain
AI_REQUEST_TIMEOUT_MS="90000"

# ------------------------------------------------------------------------------
# Universal Provider Definitions
# Define any provider with a short name used in your chains:
#   AI_PROVIDER_<NAME>_TYPE       = openai | anthropic | google | xai | groq | mistral |
#                                   deepseek | openrouter | openai-compatible
#   AI_PROVIDER_<NAME>_API_KEY    = key (optional for local servers like Ollama/LM Studio)
#   AI_PROVIDER_<NAME>_BASE_URL   = required for openai-compatible; optional override for others
#   AI_PROVIDER_<NAME>_HEADERS    = optional JSON string of extra headers
#   AI_PROVIDER_<NAME>_STRUCTURED = json_schema | json_mode | prompt  (default: json_schema)
#   AI_PROVIDER_<NAME>_VISION     = true | false (default: false)
#   AI_PROVIDER_<NAME>_TIMEOUT_MS = optional timeout in ms
# ------------------------------------------------------------------------------

# Example 1: xAI Grok
# AI_PROVIDER_GROK_TYPE="xai"
# AI_PROVIDER_GROK_API_KEY="your-xai-key-here"
# AI_PROVIDER_GROK_STRUCTURED="json_schema"
# AI_PROVIDER_GROK_VISION="true"

# Example 2: Groq (Ultra-fast inference)
# AI_PROVIDER_GROQ_TYPE="groq"
# AI_PROVIDER_GROQ_API_KEY="your-groq-key-here"
# AI_PROVIDER_GROQ_STRUCTURED="json_schema"

# Example 3: OpenAI
# AI_PROVIDER_OPENAI_TYPE="openai"
# AI_PROVIDER_OPENAI_API_KEY="your-openai-key-here"
# AI_PROVIDER_OPENAI_STRUCTURED="json_schema"
# AI_PROVIDER_OPENAI_VISION="true"

# Example 4: Google Gemini
# AI_PROVIDER_GOOGLE_TYPE="google"
# AI_PROVIDER_GOOGLE_API_KEY="your-gemini-key-here"
# AI_PROVIDER_GOOGLE_STRUCTURED="json_schema"
# AI_PROVIDER_GOOGLE_VISION="true"

# Example 5: Anthropic Claude
# AI_PROVIDER_ANTHROPIC_TYPE="anthropic"
# AI_PROVIDER_ANTHROPIC_API_KEY="your-anthropic-key-here"
# AI_PROVIDER_ANTHROPIC_STRUCTURED="json_schema"
# AI_PROVIDER_ANTHROPIC_VISION="true"

# Example 6: OpenRouter (Multi-model aggregator)
# AI_PROVIDER_OPENROUTER_TYPE="openrouter"
# AI_PROVIDER_OPENROUTER_API_KEY="your-openrouter-key-here"
# AI_PROVIDER_OPENROUTER_STRUCTURED="json_schema"

# Example 7: Ollama (Local OpenAI-compatible server — no API key needed)
# AI_PROVIDER_OLLAMA_TYPE="openai-compatible"
# AI_PROVIDER_OLLAMA_BASE_URL="http://localhost:11434/v1"
# AI_PROVIDER_OLLAMA_STRUCTURED="json_mode"

# Example 8: LM Studio (Local OpenAI-compatible server — no API key needed)
# AI_PROVIDER_LMSTUDIO_TYPE="openai-compatible"
# AI_PROVIDER_LMSTUDIO_BASE_URL="http://localhost:1234/v1"
# AI_PROVIDER_LMSTUDIO_STRUCTURED="prompt"

# Backward compatibility: legacy provider keys (used if no AI_PROVIDER_<NAME>_* is defined):
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
XAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""

# ------------------------------------------------------------------------------
# Publishing & Deployments
# ------------------------------------------------------------------------------
# Optional Vercel personal access token for static site deployment and custom domain management
VERCEL_TOKEN=""

# ------------------------------------------------------------------------------
# Email Service
# 'none' (default) logs all outgoing emails and reset links to the server console.
# 'resend' or 'smtp' activates live sending.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="none"
# If EMAIL_PROVIDER="resend":
RESEND_API_KEY=""
# If EMAIL_PROVIDER="smtp":
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@example.com"

# ------------------------------------------------------------------------------
# Stock Images (Unsplash)
# Optional: without this key, AI leaves image placeholder slots for the user to fill.
# ------------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Security & Encryption
# ------------------------------------------------------------------------------
# 32-byte base64 encryption key for customer tokens (AES-256-GCM).
# Generate with `pnpm gen:secrets`.
ENCRYPTION_KEY="your-32-byte-base64-key-here"

# Error Monitoring (Sentry — Optional)
SENTRY_DSN=""
