exports[`Shared Renderer (Canvas and Static Markup) > produces identical HTML tags across primitives and matches snapshot 1`] = `"<body id="el-id" data-element-id="el-id" data-element-type="Body" class="s_style-id"><nav id="el-id" data-element-id="el-id" data-element-type="Navbar" class=""><div style="display:flex;align-items:center;gap:8px;font-weight:bold"><span>Artisan Coffee</span></div><div style="display:flex;align-items:center;gap:16px"></div></nav><section id="el-id" data-element-id="el-id" data-element-type="Section" class=""><h1 id="el-id" data-element-id="el-id" data-element-type="Heading" class="">Fresh Morning Roast</h1><p id="el-id" data-element-id="el-id" data-element-type="Text" class="">Locally sourced beans roasted daily.</p><button id="el-id" data-element-id="el-id" data-element-type="Button" type="button" class="">Order Now</button></section><form id="el-id" data-element-id="el-id" data-element-type="Form" data-form-id="contact" class=""><input type="hidden" name="_formId" value="contact"/><div style="display:flex;flex-direction:column;gap:4px;width:100%"><label style="font-size:14px;font-weight:500;font-family:inherit">Email Address <span style="color:red">*</span></label><input id="el-id" data-element-id="el-id" data-element-type="Input" type="email" required="" class="" style="font-family:inherit" name="email"/></div><div style="display:flex;flex-direction:column;gap:4px;width:100%"><label style="font-size:14px;font-weight:500;font-family:inherit">Message </label><textarea id="el-id" data-element-id="el-id" data-element-type="Textarea" name="inquiry" rows="3" class="" style="font-family:inherit"></textarea></div><button id="el-id" data-element-id="el-id" data-element-type="Submit" type="submit" class="">Send Message</button></form></body>"`;
